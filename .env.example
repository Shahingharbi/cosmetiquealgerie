# ─── Reception des commandes ────────────────────────────────────────────────
# Voir docs/projet/RECEPTION-COMMANDES.md pour obtenir ces valeurs.
#
# AUCUNE de ces trois variables ne porte le prefixe NEXT_PUBLIC_ : elles
# restent sur le serveur et ne partent jamais dans le code envoye au
# navigateur. C'est ce que l'ancienne solution EmailJS ne permettait pas.

# Source de verite : l'URL du deploiement Apps Script du tableur.
GOOGLE_SHEET_WEBHOOK=

# Notification WhatsApp immediate, via CallMeBot.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ─── Filet de dernier recours ───────────────────────────────────────────────
# Public par nature : sert a construire le lien WhatsApp que le CLIENT ouvre
# lui-meme, uniquement si la route serveur a echoue.
NEXT_PUBLIC_WHATSAPP=
