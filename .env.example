# ─── Reception des commandes ────────────────────────────────────────────────
# Voir docs/projet/RECEPTION-COMMANDES.md pour obtenir ces valeurs.
#
# AUCUNE de ces variables ne porte le prefixe NEXT_PUBLIC_ : elles restent sur
# le serveur et ne partent jamais dans le code envoye au navigateur.
#
# Il suffit d'UN canal configure pour recevoir les commandes. EmailJS est le
# canal principal ; le tableur et WhatsApp sont optionnels.

# E-mail de commande, via EmailJS appele depuis le serveur.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optionnel : carnet de commandes, l'URL du deploiement Apps Script du tableur.
GOOGLE_SHEET_WEBHOOK=

# Optionnel : alerte WhatsApp, via CallMeBot.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ─── Filet de dernier recours ───────────────────────────────────────────────
# Public par nature : sert a construire le lien WhatsApp que le CLIENT ouvre
# lui-meme, uniquement si la route serveur a echoue.
NEXT_PUBLIC_WHATSAPP=
